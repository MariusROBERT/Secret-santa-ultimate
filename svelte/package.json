{
  "name": "svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "npm run db:generate",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node migrate.js",
    "test:migrations": "node test-migrations.js",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.38.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^0.554.0",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/node-schedule": "^2.1.8",
    "@vitest/browser": "^3.2.4",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.5.0",
    "jsrepo": "^3.8.3",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "runed": "^0.36.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-toolbelt": "^0.10.7",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "node-schedule": "^2.1.2",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  }
}
